{
  "name": "sjrd",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "pnpm --filter @sjrd/web dev",
    "dev:app": "pnpm --filter @sjrd/app start",
    "build:web": "pnpm --filter @sjrd/web build",
    "build:app": "pnpm --filter @sjrd/app build",
    "typecheck": "pnpm --filter @sjrd/web typecheck && pnpm --filter @sjrd/app typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:start": "cd packages/backend && supabase start",
    "db:reset": "pnpm db:seed",
    "db:seed": "cd packages/backend && supabase db query < seed.sql"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.3",
    "@supabase/cli": "^1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5",
    "typescript-eslint": "^8.68.0"
  }
}

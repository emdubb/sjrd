# Local Supabase stack (used by `pnpm db:start` / `pnpm db:seed`)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=anon
SUPABASE_SERVICE_ROLE_KEY=service_role_key

# CLI auth for pushing migrations from your machine (not read by the app).
# Generate at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Used by `pnpm db:push:dev` — project ref + DB password from your dev project's
# Settings > Database page
SUPABASE_DEV_PROJECT_REF=
SUPABASE_DEV_DB_PASSWORD=

# Used by `pnpm db:push:prod` — project ref + DB password from your prod project's
# Settings > Database page
SUPABASE_PROD_PROJECT_REF=
SUPABASE_PROD_DB_PASSWORD=
